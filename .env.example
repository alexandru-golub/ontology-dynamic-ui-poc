# Neo4j (required)
NEO4J_URI=bolt://localhost:7689
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-dev-password

# DB-backed auth
# HAT_PASSWORD: one password for all seeded demo accounts (dev convenience).
# If unset, `npm run seed` generates random passwords and prints them.
HAT_PASSWORD=

# Session lifetime in days (default 30)
SESSION_DAYS=30

# Dev-only: set to a user id to skip login entirely (never set in production)
# AUTH_BYPASS_USER=
